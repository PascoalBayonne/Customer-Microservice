    {
      "id": "e3192782745",
      "type": "text",
      "x": 1966,
      "y": 1023,
      "width": 553,
      "height": 70,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g8472908314"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 937167878,
      "version": 1,
      "versionNonce": 472580524,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790005987766,
      "link": null,
      "locked": false,
      "text": "no decisions, scores, amounts, rates, IBANs or document contents in the body\nthe email says something is ready and links to the authenticated portal\nattachments are links into the document store (SECCI, ESIS, contract)\ninbound payslips and ID documents are quarantined and scanned first",
      "originalText": "no decisions, scores, amounts, rates, IBANs or document contents in the body\nthe email says something is ready and links to the authenticated portal\nattachments are links into the document store (SECCI, ESIS, contract)\ninbound payslips and ID documents are quarantined and scanned first",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e4335068562",
      "type": "text",
      "x": 100,
      "y": 985,
      "width": 864,
      "height": 75,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 653430574,
      "version": 1,
      "versionNonce": 4222469,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790005987766,
      "link": null,
      "locked": false,
      "text": "Two status levels \u2014 the whole point of the bounce case:\n  OutboundEmail.dispatchStatus     QUEUED \u2192 SENT | REJECTED | FAILED     (our side)\n  RecipientDelivery.status         PENDING \u2192 DELIVERED | BOUNCED         (each recipient's side)\nAn email to three people can be delivered to two and bounce for one.",
      "originalText": "Two status levels \u2014 the whole point of the bounce case:\n  OutboundEmail.dispatchStatus     QUEUED \u2192 SENT | REJECTED | FAILED     (our side)\n  RecipientDelivery.status         PENDING \u2192 DELIVERED | BOUNCED         (each recipient's side)\nAn email to three people can be delivered to two and bounce for one.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
