      "isDeleted": false,
      "boundElements": null,
      "updated": 1790005987766,
      "link": null,
      "locked": false,
      "text": "It did NOT crash. It read OutboundEmailDelivered\nas OutboundEmailQueued \u2014 silently.\n\nAvro falls back to the first branch that structurally\nfits. Empty records, and records whose fields all have\ndefaults, fit anything. The registry cannot catch this:\nit only checks that NEW readers can read OLD data.",
      "originalText": "It did NOT crash. It read OutboundEmailDelivered\nas OutboundEmailQueued \u2014 silently.\n\nAvro falls back to the first branch that structurally\nfits. Empty records, and records whose fields all have\ndefaults, fit anything. The registry cannot catch this:\nit only checks that NEW readers can read OLD data.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
